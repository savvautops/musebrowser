#!/usr/bin/env python3
"""Custom websockify wrapper for SAO Browser / musebrowser.

Serves noVNC static files + WebSockets on 6080, while proxying
/sao-control/* to http://127.0.0.1:9280/ so that overlay.js can communicate
with the broker seamlessly without CORS issues.
"""

import sys
import urllib.request
import urllib.error
import websockify.websocketproxy as wsp

class SaoProxyRequestHandler(wsp.ProxyRequestHandler):
    def do_GET(self):
        if self.path.startswith('/sao-control/'):
            target_path = self.path[len('/sao-control'):]
            url = f'http://127.0.0.1:9280{target_path}'
            try:
                with urllib.request.urlopen(url, timeout=15) as resp:
                    data = resp.read()
                    self.send_response(resp.status)
                    for k, v in resp.headers.items():
                        self.send_header(k, v)
                    self.end_headers()
                    self.wfile.write(data)
            except urllib.error.HTTPError as e:
                data = e.read()
                self.send_response(e.code)
                for k, v in e.headers.items():
                    self.send_header(k, v)
                self.end_headers()
                self.wfile.write(data)
            except Exception as e:
                self.send_error(502, f"Broker proxy error: {e}")
            return
        super().do_GET()

    def do_POST(self):
        if self.path.startswith('/sao-control/'):
            target_path = self.path[len('/sao-control'):]
            url = f'http://127.0.0.1:9280{target_path}'
            length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(length) if length > 0 else None
            req = urllib.request.Request(url, data=body, method='POST')
            for k, v in self.headers.items():
                if k.lower() not in ('host', 'content-length'):
                    req.add_header(k, v)
            try:
                with urllib.request.urlopen(req, timeout=15) as resp:
                    data = resp.read()
                    self.send_response(resp.status)
                    for k, v in resp.headers.items():
                        self.send_header(k, v)
                    self.end_headers()
                    self.wfile.write(data)
            except urllib.error.HTTPError as e:
                data = e.read()
                self.send_response(e.code)
                for k, v in e.headers.items():
                    self.send_header(k, v)
                self.end_headers()
                self.wfile.write(data)
            except Exception as e:
                self.send_error(502, f"Broker proxy error: {e}")
            return
        self.send_error(405, 'Method Not Allowed')

class SaoWebSocketProxy(wsp.WebSocketProxy):
    def __init__(self, *args, **kwargs):
        super().__init__(RequestHandlerClass=SaoProxyRequestHandler, *args, **kwargs)

if __name__ == '__main__':
    wsp.WebSocketProxy = SaoWebSocketProxy
    wsp.websockify_init()
